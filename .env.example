PORT=5000
# Use the TRANSACTION-mode pooler (port 6543), not session mode (5432): session mode
# pins a dedicated Postgres backend per client connection, so a pool of idle
# connections exhausts the pooler. `pgbouncer=true` is required (it disables
# prepared statements); `connection_limit` caps the single shared pool created in
# src/lib/prisma.js — without it Prisma defaults to num_cpus*2+1 read from the HOST.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Twilio API credentials
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# Cloudflare R2 Credentials
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="whatsapp-bot-media"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# Twenty CRM automations
TWENTY_BASE_URL="https://twenty-automations.onrender.com"

# OpenClaw agent bridge (/bot command). OPENCLAW_URL is the Lightsail box's
# private Tailscale Serve address; OPENCLAW_TOKEN is the gateway auth token.
OPENCLAW_URL="https://openclaw-1.your-tailnet.ts.net"
OPENCLAW_TOKEN="your_openclaw_gateway_token"

# OpenAI key for transcribing WhatsApp voice notes (audio -> text)
OPENAI_API_KEY="your_openai_api_key"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"

# Read-only role for assistant DB lookups (src/services/dbReadService.js). Stays on
# the SESSION-mode port (5432) because node-postgres sends statement_timeout as a
# startup parameter; the pool is capped at 3 so its footprint is negligible.
DATABASE_URL_RO="postgresql://wog_ro.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Warehouse data entry has moved to the Scout web form (the bot no longer ingests it).
SCOUT_FORM_URL="https://scout-frontend-mu.vercel.app/"
